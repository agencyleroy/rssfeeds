{
    "name": "agencyleroy/rss-feeds",
    "description": "RSS feed from rss.app",
    "type": "craft-plugin",
    "version": "3.0.0",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "rss feeds"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Agency leroy",
            "homepage": "https://agencyleroy.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0.0"
    },
    "autoload": {
        "psr-4": {
          "agencyleroy\\rssfeeds\\": "src/"
        }
    },
    "extra": {
        "name": "Rss Feeds",
        "handle": "rss-feeds",
        "components": {
            "rssFeedsService": "agencyleroy\\rssfeeds\\services\\RssFeedsService"
        },
        "class": "agencyleroy\\rssfeeds\\RssFeeds"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    }
}
